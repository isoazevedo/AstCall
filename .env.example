# Copie para .env e ajuste. O arquivo .env NUNCA deve ser versionado.
# Caminhos relativos são resolvidos a partir da raiz do repositório.

NODE_ENV=development
LOG_LEVEL=info

# Endereço do servidor HTTP/WebSocket do backend
HTTP_HOST=127.0.0.1
HTTP_PORT=8090
# Atrás de Nginx/Apache: usar X-Forwarded-For como IP do cliente
TRUST_PROXY=false

# Lista de servidores Asterisk (sem segredos)
SERVERS_FILE=config/servers.json

# Grava todo o tráfego AMI recebido (para criar fixtures de teste). Deixe comentado em produção.
# AMI_RECORD_DIR=recordings

# Auditoria das ações do painel (uma linha JSON por ação). Consulta: npm run audit
# AUDIT_FILE=/var/log/astcall/audit.jsonl

# Reconciliações periódicas com o Asterisk (ms; 0 desliga)
# QUEUE_REFRESH_MS=60000
# CHANNEL_RECONCILE_MS=60000

# Credenciais AMI por servidor: AMI_<ID>_USERNAME / AMI_<ID>_SECRET
# (id em maiúsculas; caracteres fora de A-Z e 0-9 viram "_", ex.: pbx-2 -> AMI_PBX_2_...)
AMI_PBX1_USERNAME=astcall
AMI_PBX1_SECRET=troque-esta-senha

# Autenticação: local (standalone) | external (AzCall) | both
AUTH_MODE=local
JWT_TTL_SECONDS=600

# Emissor local (modo standalone). Gere as chaves com: npm run keys:generate
LOCAL_JWT_ISSUER=astcall
LOCAL_JWT_PRIVATE_KEY_FILE=keys/local-private.pem
LOCAL_JWT_PUBLIC_KEY_FILE=keys/local-public.pem
USERS_DB_FILE=data/users.sqlite
# Validade da sessão (cookie de renovação), renovada a cada uso
REFRESH_TTL_HOURS=12
# Cookie só via HTTPS (padrão: true em produção, false em desenvolvimento)
# COOKIE_SECURE=true

# Emissor externo (modo integrado com o AzCall)
EXTERNAL_JWT_ISSUER=azcall
# EXTERNAL_JWT_PUBLIC_KEY_FILE=keys/azcall-public.pem
