{
  "name": "@astcall/realtime",
  "version": "0.1.0",
  "private": true,
  "description": "Backend de tempo real do AstCall: AMI, estado do PBX e WebSocket",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --conditions=development src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@astcall/shared": "*",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
