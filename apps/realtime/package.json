{
  "name": "@astcall/realtime",
  "version": "0.1.0",
  "private": true,
  "description": "Backend de tempo real do AstCall: AMI, estado do PBX e WebSocket",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning --conditions=development src/main.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "keys:generate": "tsx --disable-warning=ExperimentalWarning --conditions=development scripts/keys-generate.ts",
    "user": "tsx --disable-warning=ExperimentalWarning --conditions=development scripts/users.ts",
    "audit": "tsx --disable-warning=ExperimentalWarning --conditions=development scripts/audit.ts"
  },
  "dependencies": {
    "@astcall/shared": "*",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "pino": "^10.4.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
