{
  "name": "astcall",
  "private": true,
  "description": "Painel de monitoramento em tempo real para Asterisk 22",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:realtime": "npm run dev -w @astcall/realtime",
    "dev:web": "npm run dev -w @astcall/web",
    "build": "npm run build -w @astcall/shared && npm run build -w @astcall/realtime && npm run build -w @astcall/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "keys:generate": "npm run keys:generate -w @astcall/realtime --",
    "user": "npm run user -w @astcall/realtime --",
    "audit": "npm run audit -w @astcall/realtime --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
